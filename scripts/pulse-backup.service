[Unit]
Description=Snapshot Pulse SQLite database and upload to private S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/pulse-backup.env
ExecStart=/opt/pulse-backup/backup.sh
TimeoutStartSec=600
Restart=on-failure
RestartSec=15min
Nice=10
